<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The production path deliberately needs no root, location, Wi-Fi control,
         WRITE_SECURE_SETTINGS, accessibility, or Shizuku permission. The embedded
         authenticated ADB client only needs normal socket access. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ package visibility: expose only the one optional companion we
         integrate with. This is not a permission and does not grant Shizuku access. -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:label="No-WiFi ADB"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AdbTileService"
            android:exported="true"
            android:icon="@drawable/ic_adb_tile"
            android:label="No-WiFi ADB"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
